{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host",
  "description": "The local host UI webview: all app commands.",
  "webviews": [
    "host"
  ],
  "permissions": [
    "core:default",
    "allow-refresh-layout",
    "allow-set-ratios",
    "allow-commit-layout",
    "allow-reload-panel",
    "allow-add-account",
    "allow-remove-account",
    "allow-shortcut",
    "allow-panel-keys",
    "allow-set-key",
    "allow-set-recording",
    "allow-pick-save-dir",
    "allow-reset-save-dir",
    "allow-open-save-dir"
  ]
}
