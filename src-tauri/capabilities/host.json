{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host",
  "description": "The local host UI webview: all app commands.",
  "webviews": [
    "host"
  ],
  "permissions": [
    "core:default",
    "allow-refresh-layout",
    "allow-set-ratios",
    "allow-commit-layout",
    "allow-reload-panel",
    "allow-panel-memory",
    "allow-add-account",
    "allow-remove-account",
    "allow-rename-account",
    "allow-move-account",
    "allow-shortcut",
    "allow-panel-keys",
    "allow-set-key",
    "allow-set-x-key",
    "allow-set-recording",
    "allow-pick-save-dir",
    "allow-reset-save-dir",
    "allow-open-save-dir",
    "allow-open-data-dir",
    "allow-capture-close",
    "allow-capture-slice",
    "allow-capture-export",
    "allow-check-update",
    "allow-set-update-check",
    "allow-skip-update",
    "allow-open-update",
    "allow-copy-install-cmd",
    "allow-check-rules",
    "allow-set-rules-update",
    "allow-set-unread-badge",
    "allow-set-wheel-zoom"
  ]
}
