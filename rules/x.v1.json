{
  "format": 1,
  "revision": 2,
  "selectors": {
    "post": "article[data-testid=\"tweet\"]",
    "column": "[data-testid=\"primaryColumn\"]",
    "booted": "main[role=\"main\"], [data-testid=\"primaryColumn\"], [aria-modal=\"true\"]",
    "modal": "[aria-modal=\"true\"]",
    "statusLink": "a[href*=\"/status/\"]",
    "userName": "[data-testid=\"User-Name\"]",
    "avatar": "[data-testid=\"Tweet-User-Avatar\"]",
    "postText": "[data-testid=\"tweetText\"]",
    "socialContext": "[data-testid=\"socialContext\"]",
    "quoteBox": "div[role=\"link\"]",
    "actionBar": "[role=\"group\"]",
    "photo": "[data-testid=\"tweetPhoto\"]",
    "video": "[data-testid=\"videoPlayer\"], [data-testid=\"videoComponent\"]",
    "notifLink": "a[data-testid=\"AppTabBar_Notifications_Link\"], a[href=\"/notifications\"][role=\"link\"]",
    "dmLink": "a[data-testid=\"AppTabBar_DirectMessage_Link\"], a[href=\"/messages\"][role=\"link\"], a[href^=\"/i/chat\"][role=\"link\"]",
    "badge": "div, span"
  },
  "text": {
    "avatarPath": "/profile_images/",
    "emojiPath": "/emoji/"
  }
}
